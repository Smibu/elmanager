<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="260"
             x:Class="Elmanager.SLE.Dialogs.ZoomDialog">
  <StackPanel Orientation="Vertical" Margin="8" Spacing="8">
    <TextBlock Text="Zoom" FontSize="16" FontWeight="Bold" />
    <TextBox x:Name="ZoomBox" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="OkButton" Content="OK" Width="80" Click="OkButton_Click" HotKey="Enter" />
      <Button Content="Cancel" Width="80" Click="CancelButton_Click" />
    </StackPanel>
  </StackPanel>
</UserControl>
